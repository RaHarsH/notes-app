# ─────────────────────────────────────────────────────────────────
# COLLAB NOTES — Environment Variables
# Copy this file to .env and fill in your secrets
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=collab
POSTGRES_PASSWORD=collab_secret

# ── Individual DB Names ───────────────────────────────────────────
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
NOTES_DB_NAME=notes_db
HISTORY_DB_NAME=history_db
COMMENTS_DB_NAME=comments_db
NOTIFICATIONS_DB_NAME=notifications_db

# ── Database URLs (used by Prisma inside containers) ───────────────
AUTH_DATABASE_URL=postgresql://collab:collab_secret@postgres:5432/auth_db
USER_DATABASE_URL=postgresql://collab:collab_secret@postgres:5432/user_db
NOTES_DATABASE_URL=postgresql://collab:collab_secret@postgres:5432/notes_db
HISTORY_DATABASE_URL=postgresql://collab:collab_secret@postgres:5432/history_db
COMMENTS_DATABASE_URL=postgresql://collab:collab_secret@postgres:5432/comments_db
NOTIFICATIONS_DATABASE_URL=postgresql://collab:collab_secret@postgres:5432/notifications_db

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── NATS ─────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=super_secret_access_key_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Service Ports ─────────────────────────────────────────────────
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
NOTES_SERVICE_PORT=3003
COLLAB_SERVICE_PORT=3004
HISTORY_SERVICE_PORT=3005
COMMENT_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007

# ── Node ─────────────────────────────────────────────────────────
NODE_ENV=development
